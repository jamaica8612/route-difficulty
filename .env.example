# API keys must be used only by a server or serverless function.
PUBLIC_DATA_APT_BASIS_ENDPOINT=https://apis.data.go.kr/1613000/AptBasisInfoServiceV4
PUBLIC_DATA_APT_LIST_ENDPOINT=https://apis.data.go.kr/1613000/AptListService3
PUBLIC_DATA_BUILDING_HUB_ENDPOINT=https://apis.data.go.kr/1613000/BldRgstHubService
PUBLIC_DATA_SERVICE_KEY=

# Data builder input files are stored outside public/ and never deployed.
ROUTE_DATA_INPUT_DIR=./data/input
ROUTE_DATA_WORK_DIR=./data/work
ROUTE_DATA_OUTPUT_DIR=./public/data
PUBLIC_DATA_DAILY_REQUEST_LIMIT=4500

# Optional official reference dates (YYYY-MM-DD). If omitted, the boundary file
# modification date and API collection completion date are used.
ROUTE_POSTCODE_SOURCE_DATE=
ROUTE_BUILDING_SOURCE_DATE=
ROUTE_KAPT_SOURCE_DATE=

# Naver Maps Dynamic Map client ID (ncpKeyId). This is not a Naver Search API client ID.
VITE_NAVER_MAP_CLIENT_ID=
